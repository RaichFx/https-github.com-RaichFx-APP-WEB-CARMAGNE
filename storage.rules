rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && (request.auth.token.role == 'admin' || request.auth.token.role == 'superadmin');
    }

    function isWorker(id) {
      return request.auth != null
        && request.auth.token.role == 'worker'
        && request.auth.token.workerId == id;
    }

    match /certificates/{id}/{allPaths=**} {
      allow read, write: if isAdmin() || isWorker(id);
    }

    match /payslips/{id}/{allPaths=**} {
      allow read: if isAdmin() || isWorker(id);
      allow write: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
